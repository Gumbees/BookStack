# Git and IDE metadata
.git
.github
.claude

# Node modules -- installed fresh in the js-builder stage
node_modules

# Rust build artifacts -- collab/ source is needed for the wasm-builder and
# collab-server builder stages, but pre-existing target/ dirs should not be
# sent to the daemon (they can be hundreds of MB)
collab/target

# Storage directories that should never be baked into an image
storage/logs
storage/uploads
storage/backups
storage/framework/cache
storage/framework/sessions
storage/framework/views

# Environment files
.env
.env.*

# Test suite
tests

# Documentation
*.md
*.txt

# Compose files (not needed in the build context)
docker-compose*.yml

# Dev tooling (except dev/build which is needed by the JS build stage)
dev/api
dev/docs
